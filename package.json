{
  "name": "cortico-world-coding-agent-notify",
  "version": "1.2.1",
  "type": "module",
  "description": "Coopanion World for short coding-agent completion notifications",
  "license": "AGPL-3.0-or-later",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "icon": "icon.svg",
    "webUiClient": "dist/webui.js",
    "describe": "describe.json",
    "displayName": "Coding Agent Notify",
    "tags": [
      "apps"
    ],
    "locales": {
      "zh": {
        "displayName": "Coding Agent 任务通知",
        "description": "在 World 配置页按需安装 Codex、Claude Code、OpenCode、DSH、Muse Code、agy、WorkBuddy hook，由 Coopanion 简要播报任务报告。Windows 适配待验证。"
      },
      "en": {
        "displayName": "Coding Agent Notify",
        "description": "Install native Codex, Claude Code, OpenCode, DSH, Muse Code, agy and WorkBuddy hooks from the World panel. Coopanion summarizes completion reports. Windows compatibility is unverified."
      }
    }
  },
  "files": [
    "index.ts",
    "hook-runtime.ts",
    "coopanion-agent-launch.sh",
    "coopanion-agent-launch.ps1",
    "webui.ts",
    "hook.mjs",
    "icon.svg",
    "ENV_PROMPT.md",
    "dist",
    "describe.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "cortico": "0.2.13",
    "jsdom": "^30.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ThermalEng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThermalEng/coopanion-agent-notify-world.git"
  },
  "homepage": "https://github.com/ThermalEng/coopanion-agent-notify-world#readme",
  "bugs": {
    "url": "https://github.com/ThermalEng/coopanion-agent-notify-world/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "coding-agent",
    "notifications",
    "codex",
    "claude-code",
    "opencode",
    "dsh",
    "muse-code",
    "agy",
    "workbuddy"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
